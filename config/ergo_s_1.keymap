#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define FN  1

/ {
    combos {
        compatible = "zmk,combos";

        Backspace {
            bindings = <&kp BACKSPACE>;
            // Ensure these positions match your physical layout
            key-positions = <31 32>;
            layers = <0>;
        };
    };

    behaviors {
        // Define the mouse scroll behavior for encoders
        inc_dec_msc: inc_dec_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };
        // SpaceShift: Hold for one key, Tap for another
        // Usage: &ss LSHFT SPACE
        ss: space_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <120>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <52 57>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp ESCAPE    &kp N1     &kp N2    &kp N3          &kp N4     &kp N5                                                                    &kp N6     &kp N7  &kp N8          &kp N9            &kp N0             &kp BACKSPACE
&kp LEFT_GUI  &kp Q      &kp W     &kp E            &kp R      &kp T                                                                     &kp Y      &kp U   &kp I           &kp O             &kp P              &kp EQUAL
&kp TAB        &kp A      &kp S     &kp D            &kp F      &kp G                                                                     &kp H      &kp J   &kp K           &kp L             &kp SEMI           &kp SINGLE_QUOTE
&kp DEL        &kp Z      &kp X     &kp C            &kp V      &kp B                                                                     &kp N      &kp M   &kp COMMA       &kp DOT           &kp SLASH          &kp MINUS
              &kp GRAVE  &kp BSLH  &kp LEFT_ARROW  &kp RIGHT  &kp LEFT_SHIFT  &kp LCTRL  &kp LEFT_ALT  &kp CAPS   &kp RIGHT_CONTROL  &kp SPACE  &kp DOWN_ARROW  &kp UP     &kp LEFT_BRACKET  &kp RIGHT_BRACKET
                                                              &mo 1           &kp HOME                 &kp PG_UP  &kp ENTER
                                                              &kp END                                             &kp PAGE_DOWN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp RIGHT LEFT>;
        };

        FN_NUMPAD {
            bindings = <
&studio_unlock  &kp F1        &kp F2        &kp F3        &kp F4           &kp F5                                                 &kp F6           &kp F7           &kp F8           &kp F9                    &kp F10          &trans
&trans          &kp F11       &kp F12       &trans        &trans           &trans                                                 &trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9           &trans           &trans 
&trans          &trans        &trans        &trans        &kp PRINTSCREEN  &trans                                                 &trans           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6           &kp KP_PLUS      &kp KP_MULTIPLY
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3     &bt BT_SEL 4                                           &trans           &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3           &kp KP_SUBTRACT  &kp KP_DIVIDE
                &trans        &trans        &trans        &trans           &mo 2         &trans  &trans  &kp KP_NUMLOCK  &trans  &kp KP_NUMBER_0  &trans           &trans           &kp KP_DOT       &kp KP_EQUAL
                                                                           &trans        &trans          &trans          &kp KP_ENTER
                                                                           &kp INS                                       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_NEXT C_PREV &inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        Mouse {
            bindings = <
&trans  &trans  &trans  &trans          &trans           &trans                                  &trans  &trans        &trans          &trans     &trans  &trans
&trans  &trans  &trans  &trans          &trans           &trans                                  &trans  &trans        &trans          &trans     &trans  &trans
&trans  &trans  &trans  &trans          &trans           &trans                                  &trans  &mkp LCLK     &mkp MCLK       &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans          &trans           &trans                                  &trans  &trans        &trans          &trans     &trans  &trans
        &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &mmv MOVE_DOWN  &mmv MOVE_UP  &trans     &trans
                                                         &trans  &trans          &trans  &trans
                                                         &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_msc SCRL_RIGHT SCRL_LEFT &inc_dec_msc SCRL_UP SCRL_DOWN>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &trans          &trans  &trans
                                        &trans                          &trans
            >;
        };
    };
};
