#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define FN      1

&mmv {
    acceleration-exponent = <4>;      // 1 para lineal, 2 para aceleración
    time-to-max-speed-ms = <300>;     // Baja este número para que sea más rápido
    delay-ms = <0>;
};

&msc {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <2>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <175>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_backspace_right {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp BACKSPACE>;
        };

        combo_escape {
            timeout-ms = <50>;
            key-positions = <26 27 28>;
            bindings = <&kp ESCAPE>;
            layers = <0 1>;
        };

        MAC-App-Left {
            bindings = <&kp LS(LC(F4))>;
            key-positions = <40 39>;
            timeout-ms = <50>;
            layers = <0>;
        };

        MAC-App-Right {
            bindings = <&kp LC(F4)>;
            key-positions = <38 39>;
            timeout-ms = <50>;
            layers = <0>;
        };

        WIN-App-Left {
            bindings = <&kp LS(LG(LA(LC(TAB))))>;
            key-positions = <40 39>;
            layers = <1>;
            timeout-ms = <50>;
        };

        WIN-App-Right {
            bindings = <&kp LG(LA(LC(TAB)))>;
            key-positions = <39 38>;
            layers = <1>;
            timeout-ms = <50>;
        };

        TOGGLE-MAC-WIN {
            bindings = <&tog 1>;
            key-positions = <0 11>;
        };
    };
    
    key_overrides {
        shift_bslash_del: key_override {
            compatible = "zmk,key-overrides";
            // When Shift is held and "\" is pressed, send Delete
            bindings = <&kp DEL>;
            // The key to override
            keycode = <BACKSLASH>;
            // Modifier that triggers the override
            modifiers = <(MOD_LSFT | MOD_RSFT)>;
        };
    };

    behaviors {
        inc_dec_msc: inc_dec_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        MAC {
            bindings = <
&kp NON_US_BSLH  &kp N1     &kp N2                &kp N3          &kp N4     &kp N5                                                                               &kp N6            &kp N7          &kp N8     &kp N9          &kp N0           &kp EQUAL
&kp ESCAPE       &kp Q      &kp W                 &kp E           &kp R      &kp T                                                                                &kp Y             &kp U           &kp I      &kp O           &kp P            &kp UNDER
&mt LCTRL TAB    &kp A      &kp S                 &kp D           &kp F      &kp G                                                                                &kp H             &kp J           &kp K      &kp L           &kp SEMI         &kp SINGLE_QUOTE
&sk LEFT_SHIFT   &kp Z      &kp X                 &kp C           &kp V      &kp B                                                                                &kp N             &kp M           &kp COMMA  &kp DOT         &kp SLASH        &kp BACKSLASH
                 &kp GRAVE  &kp LG(LS(NUMBER_4))  &kp LEFT_ARROW  &kp RIGHT  &mt LSHIFT SPACE    &mt LEFT_ALT BACKSPACE  &kp DEL  &kp CAPS   &kp RIGHT_ALT        &mt RSHIFT SPACE  &kp DOWN_ARROW  &kp UP     &kp LEFT_BRACE  &kp RIGHT_BRACE
                                                                             &mt LEFT_GUI ENTER  &kp HOME                         &kp PG_UP  &mt RIGHT_GUI ENTER
                                                                             &lt 2 END                                                       &lt 3 PAGE_DOWN
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        WIN {
            bindings = <
&kp GRAVE  &trans           &trans           &trans  &trans  &trans                                                                             &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans           &trans           &trans  &trans  &trans                                                                             &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans           &trans           &trans  &trans  &trans                                                                             &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans           &trans           &trans  &trans  &trans                                                                             &trans  &trans  &trans  &trans  &trans  &trans
           &kp NON_US_BSLH  &kp PRINTSCREEN  &trans  &trans  &trans                  &trans  &mt LEFT_GUI DEL  &trans  &trans                   &trans  &trans  &trans  &trans  &trans
                                                             &mt LEFT_CONTROL ENTER  &trans                    &trans  &mt RIGHT_CONTROL ENTER
                                                             &trans                                                    &trans
            >;
        };

        FN_NUMPAD {
            bindings = <
&studio_unlock  &kp F1   &kp F2   &kp F3             &kp F4           &kp F5                                                &kp F6           &kp F7           &kp F8           &kp F9           &kp F10          &trans
&trans          &kp F11  &kp F12  &trans             &trans           &trans                                                &trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans           &trans
&trans          &trans   &trans   &trans             &trans           &trans                                                &trans           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS      &kp KP_MULTIPLY
&trans          &trans   &trans   &trans             &trans           &trans                                                &trans           &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_SUBTRACT  &kp KP_DIVIDE
                &trans   &trans   &kp K_VOLUME_DOWN  &kp K_VOLUME_UP  &trans  &trans  &trans  &kp KP_NUMLOCK  &trans        &kp KP_NUMBER_0  &trans           &trans           &kp KP_DOT       &kp KP_EQUAL
                                                                      &trans  &trans          &trans          &kp KP_ENTER
                                                                      &trans                                  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_NEXT C_PREV>,
                <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        Mouse {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3     &bt BT_SEL 4                                  &trans          &trans          &trans           &trans     &trans  &trans
&trans      &trans        &trans          &mmv MOVE_UP    &trans           &trans                                        &trans          &trans          &trans           &trans     &trans  &trans
&trans      &trans        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans                                        &msc SCRL_UP    &mkp LCLK       &mkp MCLK        &mkp RCLK  &trans  &trans
&trans      &trans        &trans          &trans          &trans           &trans                                        &msc SCRL_DOWN  &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans     &trans  &trans
            &trans        &trans          &trans          &trans           &trans        &trans  &trans  &trans  &trans  &trans          &trans          &trans           &trans     &trans
                                                                           &trans        &trans          &trans  &trans
                                                                           &trans                                &trans
            >;

            sensor-bindings =
                <&inc_dec_msc SCRL_RIGHT SCRL_LEFT>,
                <&inc_dec_msc SCRL_UP SCRL_DOWN>;
        };

        EXTRA {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &trans          &trans  &trans
                                        &trans                          &trans
            >;
        };
    };
};
