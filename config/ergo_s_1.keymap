#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 2000  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30   // default: 10
#define ZMK_MOUSE_SCRL_VAL 120
#define DEFAULT 0
#define FN      1

&mmv {
    acceleration-exponent = <4>;      // 1 para lineal, 2 para aceleración
    time-to-max-speed-ms = <300>;     // Baja este número para que sea más rápido
    delay-ms = <0>;
};

&msc {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <2>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <175>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_backspace {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&bspc_del>;
            layers = <0 1>;
        };

        combo_escape {
            timeout-ms = <50>;
            key-positions = <26 27 28>;
            bindings = <&kp ESCAPE>;
            layers = <0 1>;
        };

        combo_MAC-App-Left {
            bindings = <&kp LC(F4)>;
            key-positions = <40 39>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_MAC-App-Right {
            bindings = <&kp LS(LC(F4))>;
            key-positions = <38 39>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_WIN-App-Left {
            bindings = <&kp LG(LA(LC(TAB)))>;
            key-positions = <40 39>;
            layers = <1>;
            timeout-ms = <50>;
        };

        combo_WIN-App-Right {
            bindings = <&kp LS(LG(LA(LC(TAB))))>;
            key-positions = <39 38>;
            layers = <1>;
            timeout-ms = <50>;
        };

        combo_TOGGLE-MAC-WIN {
            bindings = <&tog 1>;
            key-positions = <0 11>;
        };

        combo_TAB {
            bindings = <&kp TAB>;
            key-positions = <28 27>;
        };

        combo_CAPS_WORD {
            bindings = <&kp CAPSLOCK>;
            key-positions = <36 47>;
            layers = <0 1>;
        };


    };

    behaviors {
        inc_dec_msc: inc_dec_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        gresc_mac: grave_escape_mac {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp NON_US_BSLH>;
            mods = <(MOD_LALT)>;
        };

        gresc_win: grave_escape_win {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LALT)>;
        };

        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ctrl_q_altf4: ctrl_q_altf4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&kp LA(F4)>;

            mods = <(MOD_LCTL|MOD_RCTL)>;  // Changed from 'modifiers'
        };

        sk: sticky_key {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            quick-release;
        };
    };

    macros {
        // Macro para limpiar conexiones Bluetooth antes de cambiar de perfil
        bt0_clean: bt0_clean {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&bt BT_DISC 0>
                , <&bt BT_DISC 1>
                , <&bt BT_DISC 2>
                , <&bt BT_DISC 3>
                , <&bt BT_DISC 4>
                , <&bt BT_SEL 0>; // Seleccionar perfil 0
        };
        bt1_clean: bt1_clean {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&bt BT_DISC 0>
                , <&bt BT_DISC 1>
                , <&bt BT_DISC 2>
                , <&bt BT_DISC 3>
                , <&bt BT_DISC 4>
                , <&bt BT_SEL 1>; // Seleccionar perfil 1
        };
	bt2_clean: bt2_clean {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&bt BT_DISC 0>
                , <&bt BT_DISC 1>
                , <&bt BT_DISC 2>
                , <&bt BT_DISC 3>
                , <&bt BT_DISC 4>
                , <&bt BT_SEL 2>; // Seleccionar perfil 2
        };
	bt3_clean: bt3_clean {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&bt BT_DISC 0>
                , <&bt BT_DISC 1>
                , <&bt BT_DISC 2>
                , <&bt BT_DISC 3>
                , <&bt BT_DISC 4>
                , <&bt BT_SEL 3>; // Seleccionar perfil 3
        };
	bt4_clean: bt4_clean {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&bt BT_DISC 0>
                , <&bt BT_DISC 1>
                , <&bt BT_DISC 2>
                , <&bt BT_DISC 3>
                , <&bt BT_DISC 4>
                , <&bt BT_SEL 4>; // Seleccionar perfil 4
        };
	
    };


    keymap {
        compatible = "zmk,keymap";

        MAC {
            bindings = <
&mt NON_US_BSLH ESC  &kp N1         &kp N2                &kp N3          &kp N4     &kp N5                                                                                                &kp N6     &kp N7          &kp N8     &kp N9    &kp N0     &mt EQUAL &bspc_del
&kp TAB              &kp Q          &kp W                 &kp E           &kp R      &kp T                                                                                                 &kp Y      &kp U           &kp I      &kp O     &kp P      &kp MINUS
&kp LCTRL            &kp A          &kp S                 &kp D           &kp F      &kp G                                                                                                 &kp H      &kp J           &kp K      &kp L     &kp SEMI   &kp SINGLE_QUOTE
&sk LSHIFT           &kp Z          &kp X                 &kp C           &kp V      &kp B                                                                                                 &kp N      &kp M           &kp COMMA  &kp DOT   &kp SLASH  &kp BACKSLASH
                     &kp GRAVE      &kp LG(LS(NUMBER_4))  &kp LEFT_ARROW  &kp RIGHT  &mt LSHIFT SPACE    &mt LEFT_ALT BACKSPACE  &mt LEFT_GUI DEL  &mt LEFT_GUI CAPS  &kp RIGHT_ALT        &kp SPACE  &kp DOWN_ARROW  &kp UP     &kp LBKT  &mt RSHIFT RBKT
                                                                                     &mt LEFT_GUI ENTER  &kp HOME                                  &kp PG_UP          &kp ENTER
                                                                                     &lt 2 END                                                                        &lt 3 PAGE_DOWN
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        WIN {
            bindings = <
&mt GRAVE ESC  &trans           &trans           &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans         &ctrl_q_altf4    &trans           &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans         &trans           &trans           &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans         &trans           &trans           &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
               &kp NON_US_BSLH  &kp PRINTSCREEN  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                             &mt LEFT_CONTROL SPACE  &trans          &trans  &trans
                                                             &trans                                  &trans
            >;
        };

        FN_NUMPAD {
            bindings = <
&trans          &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                                                          &kp F6           &kp F7           &kp F8           &kp F9           &kp F10          &trans
&trans          &kp F11  &kp F12  &trans   &trans   &trans                                                          &trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans           &trans
&trans          &trans   &trans   &trans   &trans   &trans                                                          &trans           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS      &kp KP_MULTIPLY
&trans          &trans   &trans   &trans   &trans   &trans                                                          &trans           &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_SUBTRACT  &kp KP_DIVIDE
                &trans   &trans   &trans   &trans   &kp C_PP  &kp C_VOL_DN  &kp C_VOL_UP  &kp KP_NUMLOCK  &trans    &kp KP_NUMBER_0  &trans           &trans           &kp KP_DOT       &kp KP_EQUAL
                                                              &trans    &trans                      &trans          &kp KP_ENTER
                                                              &trans                                                &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_NEXT C_PREV>,
                <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        Bluetooth {
            bindings = <
&studio_unlock   &bt0_clean    &bt1_clean      &bt2_clean      &bt3_clean       &bt4_clean                                       &trans          &trans          &trans           &trans     &trans  &bt BT_CLR
&trans           &trans        &trans          &mmv MOVE_UP    &trans           &trans                                           &trans          &trans          &trans           &trans     &trans  &trans
&trans           &trans        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans                                           &msc SCRL_UP    &mkp LCLK       &mkp MCLK        &mkp RCLK  &trans  &trans
&trans           &trans        &trans          &trans          &trans           &trans                                           &msc SCRL_DOWN  &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans     &trans  &trans
                 &trans        &trans          &trans          &trans           &trans        &trans  &trans  &trans  &kp GLOBE  &trans          &trans          &trans           &trans     &trans
                                                                                &trans        &trans          &trans  &trans
                                                                                &trans                                &trans
            >;

            sensor-bindings =
                <&inc_dec_msc SCRL_RIGHT SCRL_LEFT>,
                <&inc_dec_msc SCRL_UP SCRL_DOWN>;
        };

        EXTRA {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &trans          &trans  &trans
                                        &trans                          &trans
            >;
        };
    };
};
