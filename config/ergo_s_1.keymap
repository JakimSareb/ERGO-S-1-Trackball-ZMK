#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define FN      1

/ {
    combos {
        compatible = "zmk,combos";

        // Combo Q (13) + W (14) = Backspace
        combo_backspace_left {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&kp BACKSPACE>;
        };

        // Combo J (31) + K (32) = Backspace
        combo_backspace_right {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp BACKSPACE>;
        };

        // Combo S (27) + D (28) + F (29) = Escape
        combo_escape {
            timeout-ms = <50>;
            key-positions = <27 28 29>;
            bindings = <&kp ESCAPE>;
        };
    };

    behaviors {
        inc_dec_msc: inc_dec_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };

        // Mod-Tap con prioridad al Tap (para los Shifts)
        ht_tp: hold_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_PREFERRED";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Layer-Tap con prioridad al Tap (para Mo 1 y Mo 2)
        lt_tp: layer_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_PREFERRED";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&gresc          &kp N1     &kp N2     &kp N3          &kp N4     &kp N5                                                                      &kp N6     &kp N7  &kp N8          &kp N9            &kp N0             &kp BACKSPACE
&kp LEFT_GUI    &kp Q      &kp W      &kp E            &kp R      &kp T                                                                      &kp Y      &kp U   &kp I           &kp O             &kp P              &kp EQUAL
&kp TAB         &kp A      &kp S      &kp D            &kp F      &kp G                                                                      &kp H      &kp J   &kp K           &kp L             &kp SEMI           &kp SINGLE_QUOTE
&kp DEL         &kp Z      &kp X      &kp C            &kp V      &kp B                                                                      &kp N      &kp M   &kp COMMA       &kp DOT           &kp SLASH          &kp MINUS
                &kp NUBS  &kp BSLH  &kp LEFT_ARROW  &kp RIGHT  &ht_tp LSHIFT SPACE  &kp LCTRL  &kp LEFT_ALT  &kp RALT   &kp LGUI             &ht_tp RSHIFT SPACE  &kp DOWN_ARROW  &kp UP      &kp LEFT_BRACKET  &kp RIGHT_BRACKET
                                                              &lt_tp 1 ENTER       &kp HOME                             &kp RIGHT_CONTROL    &lt_tp 2 ENTER
                                                              &kp END                                                                        &kp CAPS
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp RIGHT LEFT>;
        };

        FN_NUMPAD {
            bindings = <
&studio_unlock  &kp F1        &kp F2        &kp F3        &kp F4           &kp F5                                                 &kp F6           &kp F7           &kp F8           &kp F9                    &kp F10          &trans
&trans          &kp F11       &kp F12       &trans        &trans           &trans                                                 &trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9           &trans           &trans 
&trans          &trans        &trans        &trans        &kp PRINTSCREEN  &trans                                                 &kp PAGE_UP      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6           &kp KP_PLUS      &kp KP_MULTIPLY
&trans          &trans        &trans        &trans        &trans           &trans                                                 &kp PAGE_DOWN    &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3           &kp KP_SUBTRACT  &kp KP_DIVIDE
                &trans        &trans        &trans        &trans           &trans         &trans  &trans  &kp KP_NUMLOCK  &trans  &kp KP_NUMBER_0  &trans           &trans           &kp KP_DOT       &kp KP_EQUAL
                                                                           &trans        &trans          &trans          &kp KP_ENTER
                                                                           &kp INS                                       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_NEXT C_PREV &inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        Mouse {
            bindings = <
&bt BT_CLR             &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3     &bt BT_SEL 4                                               &trans  &trans        &trans          &trans     &trans  &trans
&trans  &trans         &trans         &mmv MOVE_UP    &trans           &trans                                                 &trans            &trans        &trans          &trans     &trans  &trans
&trans  &trans         &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans                                                 &kp SCRL_UP       &kp LCLK     &mkp MCLK       &mkp RCLK  &trans  &trans
&trans  &trans         &trans         &trans          &trans           &trans                                                 &kp SCRL_DOWN     &trans        &trans          &trans     &trans  &trans
        &trans         &trans         &trans          &trans           &trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans
                                                                               &trans  &trans          &trans  &trans
                                                                               &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_msc SCRL_RIGHT SCRL_LEFT &inc_dec_msc SCRL_UP SCRL_DOWN>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                         &trans  &trans          &trans  &trans
                                         &trans                          &trans
            >;
        };
    };
};
